<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>dev.solidsilver.ond</id>
  <name>Ond</name>
  <summary>Play music from a Navidrome server</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <developer id="dev.solidsilver">
    <name>Luke M</name>
  </developer>
  <description>
    <p>
      Ond is a desktop player for Navidrome. It streams or downloads your
      library, plays gapless with ReplayGain, keeps a queue that shows where
      each track came from, and can check your files for fake hi-res and
      loudness.
    </p>
  </description>
  <launchable type="desktop-id">dev.solidsilver.ond.desktop</launchable>
  <url type="homepage">https://github.com/Solidsilver/ond</url>
  <url type="bugtracker">https://github.com/Solidsilver/ond/issues</url>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="0.2.0" date="2026-10-24">
      <description>
        <p>First release for Linux and Windows.</p>
      </description>
    </release>
    <release version="0.1.0" date="2026-10-23"/>
  </releases>
  <provides>
    <binary>ond</binary>
  </provides>
</component>
